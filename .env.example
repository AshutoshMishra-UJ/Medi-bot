# ── DATABASE ──────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/medibot_dev"

# ── AUTH ──────────────────────────────────────────────────────
JWT_SECRET="dev-secret-change-in-prod-minimum-32-characters"
JWT_EXPIRES_IN="7d"

# ── PORTS ─────────────────────────────────────────────────────
NODE_ENV="development"
API_GATEWAY_PORT=3000
PATIENT_SERVICE_PORT=3001
DOCUMENT_SERVICE_PORT=3002

# ── SERVICE URLS (used by api-gateway to proxy) ───────────────
PATIENT_SERVICE_URL="http://localhost:3001"
DOCUMENT_SERVICE_URL="http://localhost:3002"

# ── DOCUMENT PIPELINE ─────────────────────────────────────────
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=20
# OCR provider options: "local_tesseract" | "textract"
OCR_PROVIDER="local_tesseract"

# ── NER MICROSERVICE (Python FastAPI) ─────────────────────────
NER_SERVICE_URL="http://localhost:8000"

# ── REDIS (BullMQ background jobs) ────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379

# ── AWS (only needed if OCR_PROVIDER=textract) ────────────────
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="medibot-dev-docs"

# ── RATE LIMITING ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── CONFIDENCE THRESHOLDS ─────────────────────────────────────
CONFIDENCE_AUTO_COMMIT=0.85
CONFIDENCE_USER_CONFIRM=0.60

# ── CORS ──────────────────────────────────────────────────────
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"
